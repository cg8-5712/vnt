{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VNT2",
  "version": "2.1.0",
  "identifier": "io.github.cg8-5712.vnt2.desktop",
  "build": {
    "beforeDevCommand": "yarn --cwd ../vnt-web/frontend dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "yarn --cwd ../vnt-web/frontend build",
    "frontendDist": "../../vnt-web/static"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "VNT2 desktop app",
    "longDescription": "VNT2 desktop app for Windows, Linux, and macOS.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
